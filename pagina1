<script>
  var clip = document.getElementById('clip');
  try {
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) { clip.removeAttribute('autoplay'); clip.pause(); clip.controls = true; }
  } catch (e) {}

  var pct = document.getElementById('pct');
  var bar = document.getElementById('bar');
  var meter = document.getElementById('meter');
  function update(){
    var h = document.documentElement;
    var max = h.scrollHeight - h.clientHeight;
    var y = window.scrollY || h.scrollTop || 0;
    var p = max > 0 ? Math.min(100, Math.round(y / max * 100)) : 0;
    pct.textContent = p + '%';
    bar.style.transform = 'scaleX(' + (p / 100) + ')';
    meter.setAttribute('aria-valuenow', p);
  }
  window.addEventListener('scroll', update, {passive:true});
  window.addEventListener('resize', update);
  update();
</script>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Método Escolhas</title>
<meta name="description" content="Guia com o passo a passo da série @escolhas.app: roteiro, narração, vídeo feito com IA e votação nos comentários.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  /* Layout (Revenue-Centric Design): Hero com prova real (clipe do episódio) e CTA com click trigger → Dor (3) → Solução
     (ciclo + como é feito) → Prova (print + views por episódio) → O que tem dentro → Para quem é (filtro) → Oferta com
     mockup do produto → CTA final. CTA a cada ~1,5 seção, barra fixa no celular, HUD da série no topo. */
  --bg:#0a0e2a;
  --panel:#131a44;
  --line:#2a3470;
  --ink:#f6f3ea;
  --muted:#aab2dc;
  --yellow:#ffd21f;
  --yellow-deep:#b38f00;
  --blue:#3fa7ff;
  --green:#4be08a;
  --red:#ff6b6b;
  --display:'Anton','Impact','Arial Narrow',sans-serif;
  --body:'Figtree','Segoe UI',system-ui,sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:72px}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.55;padding-bottom:84px;
  background-image:radial-gradient(900px 500px at 85% -5%,#1f2a7a55,transparent 70%),radial-gradient(700px 480px at -10% 40%,#5a1b4a33,transparent 70%);}
img,video{max-width:100%;display:block}
a{color:inherit}
.wrap{width:100%;max-width:1080px;margin:0 auto;padding:0 20px}
h1,h2,h3{font-family:var(--display);font-weight:400;text-transform:uppercase;letter-spacing:.01em;line-height:1.04;margin:0;text-wrap:balance}
h1{font-size:clamp(2.4rem,7vw,4.3rem);text-shadow:0 4px 0 #000}
h1 em,h2 em{font-style:normal;color:var(--yellow)}
h2{font-size:clamp(1.9rem,5vw,2.9rem);text-shadow:0 3px 0 #000}
h3{font-size:1.2rem;letter-spacing:.02em}
p{margin:0}
.lead{font-size:1.2rem;max-width:36em}
.fine{font-size:.85rem;color:var(--muted)}
.badge{display:inline-block;font-family:var(--display);letter-spacing:.06em;text-transform:uppercase;font-size:.9rem;background:#000;color:var(--yellow);border:2px solid var(--yellow);border-radius:999px;padding:6px 14px}

/* HUD */
.hud{position:sticky;top:0;z-index:20;background:#070a20ee;backdrop-filter:blur(6px);border-bottom:2px solid #000}
.hud__in{max-width:1080px;margin:0 auto;padding:10px 20px;display:flex;align-items:center;gap:12px}
.hud__tag{font-family:var(--display);font-size:1rem;letter-spacing:.04em;color:var(--yellow);white-space:nowrap}
.meter{position:relative;flex:1;height:38px;border-radius:10px;border:2px solid #000;background:#0d1236;overflow:hidden;display:flex;align-items:center;justify-content:space-between;padding:0 12px;min-width:0}
.meter i{position:absolute;inset:0;background:linear-gradient(90deg,var(--yellow),var(--green));transform-origin:left;transform:scaleX(0);transition:transform .15s linear;opacity:.9}
.meter small,.meter b{position:relative;z-index:1;font-family:var(--display);letter-spacing:.06em;text-shadow:0 2px 0 #000;color:#fff}
.meter small{font-size:.8rem}
.meter b{font-size:1.15rem;font-weight:400;font-variant-numeric:tabular-nums}

/* CTA */
.cta{display:grid;gap:8px;justify-items:start}
.cta--center{justify-items:center;text-align:center}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--display);text-transform:uppercase;letter-spacing:.04em;font-size:1.3rem;
  background:var(--yellow);color:#0a0e2a;text-decoration:none;padding:18px 30px;border-radius:14px;border:3px solid #000;box-shadow:0 6px 0 var(--yellow-deep),0 6px 0 3px #000;
  transition:transform .08s,box-shadow .08s;cursor:pointer}
.btn:hover{transform:translateY(2px);box-shadow:0 4px 0 var(--yellow-deep),0 4px 0 3px #000}
.btn:active{transform:translateY(6px);box-shadow:0 0 0 var(--yellow-deep),0 0 0 3px #000}
.btn:focus-visible,a:focus-visible,.strip:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
.btn--sm{font-size:.95rem;padding:9px 14px;border-radius:10px;box-shadow:0 3px 0 var(--yellow-deep),0 3px 0 3px #000;white-space:nowrap}
.btn--block{width:100%}
.trigger{font-size:.9rem;color:var(--muted)}
.trust{display:inline-flex;align-items:center;gap:6px;font-size:.85rem;color:var(--green);font-weight:700}
.trust svg{width:15px;height:15px}

.ticks{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.ticks li{position:relative;padding-left:30px}
.ticks li::before{content:"";position:absolute;left:2px;top:.35em;width:14px;height:8px;border-left:4px solid var(--green);border-bottom:4px solid var(--green);transform:rotate(-45deg)}
.ticks--no li::before{width:14px;height:14px;border:0;transform:none;top:.3em;background:
  linear-gradient(45deg,transparent 43%,var(--red) 43% 57%,transparent 57%),linear-gradient(-45deg,transparent 43%,var(--red) 43% 57%,transparent 57%)}

/* Hero */
.hero{display:grid;gap:34px;padding-top:40px;padding-bottom:20px;align-items:center}
.hero__copy{display:grid;gap:20px;justify-items:start}
.proofrow{display:flex;flex-wrap:wrap;gap:10px}
.proofrow span{background:var(--panel);border:2px solid #000;border-radius:12px;padding:8px 12px;font-size:.9rem;color:var(--muted)}
.proofrow b{font-family:var(--display);font-weight:400;font-size:1.35rem;color:var(--yellow);margin-right:6px;letter-spacing:.02em}
.phone{position:relative;width:min(300px,78vw);margin:0 auto;border-radius:34px;border:6px solid #000;background:#000;box-shadow:0 18px 0 #00000066,0 0 0 2px var(--line);overflow:hidden;transform:rotate(2deg)}
.phone video{width:100%;aspect-ratio:9/16;object-fit:cover}
.phone__tag{position:absolute;left:10px;right:10px;bottom:12px;text-align:center;font-family:var(--display);letter-spacing:.05em;text-transform:uppercase;font-size:.8rem;background:#000000cc;color:var(--yellow);border-radius:8px;padding:6px}
@media (min-width:860px){.hero{grid-template-columns:1.2fr .8fr}}

/* Sections */
section.block{padding-top:76px}
.block__head{display:grid;gap:14px;margin-bottom:30px;max-width:42em}
.inline-cta{margin-top:34px}

.pains{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.pain{background:var(--panel);border:2px solid #000;border-radius:16px;padding:22px;display:grid;gap:8px;align-content:start}
.pain p{color:var(--muted);font-size:.97rem}
.pain .x{font-family:var(--display);color:var(--red);font-size:1.6rem;line-height:1}

.loop{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:18px}
.step{display:grid;gap:10px;align-content:start}
.step figure{margin:0}
.step img{width:100%;aspect-ratio:9/16;object-fit:cover;border-radius:16px;border:3px solid #000;box-shadow:0 8px 0 #00000055}
.step h3{display:flex;align-items:center;gap:10px}
.step h3 span{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--yellow);color:#0a0e2a;border:2px solid #000;font-size:1rem}
.step p{font-size:.95rem;color:var(--muted)}
.loop__back{display:flex;align-items:center;gap:12px;margin-top:22px;color:var(--yellow);font-family:var(--display);letter-spacing:.04em;text-transform:uppercase}
.loop__back svg{flex:none;width:34px;height:34px}

.pipe{margin-top:44px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;counter-reset:p}
.pipe div{position:relative;background:#0d1236;border:2px solid var(--line);border-radius:16px;padding:20px 20px 20px 64px;display:grid;gap:6px}
.pipe div::before{counter-increment:p;content:counter(p);position:absolute;left:18px;top:18px;width:32px;height:32px;border-radius:9px;background:var(--blue);color:#000;font-family:var(--display);display:grid;place-items:center;border:2px solid #000}
.pipe p{color:var(--muted);font-size:.93rem}

.proof{display:grid;gap:24px;align-items:start}
@media (min-width:860px){.proof{grid-template-columns:1.3fr .7fr}}
.proof__img{border-radius:18px;border:3px solid #000;box-shadow:0 10px 0 #00000055;overflow:hidden;background:#000}
.eps{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.eps li{display:flex;justify-content:space-between;align-items:baseline;gap:12px;background:var(--panel);border:2px solid #000;border-radius:12px;padding:10px 14px}
.eps b{font-family:var(--display);font-weight:400;font-size:1.5rem;color:var(--yellow);font-variant-numeric:tabular-nums}
.eps span{color:var(--muted);font-size:.92rem}

.strip{display:flex;gap:14px;overflow-x:auto;padding:26px 20px 20px;scroll-snap-type:x proximity;scroll-padding-left:20px;margin:0 auto;max-width:1080px}
.strip figure{margin:0;flex:0 0 140px;scroll-snap-align:start}
.strip img{width:100%;aspect-ratio:9/16;object-fit:cover;border-radius:14px;border:3px solid #000;box-shadow:0 6px 0 #00000055}
.strip figcaption{margin-top:8px;font-size:.8rem;color:var(--muted)}

.mods{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
.mod{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;background:var(--panel);border:2px solid #000;border-radius:16px;padding:20px}
.mod .n{grid-row:1/3;font-family:var(--display);font-size:2.6rem;line-height:1;color:var(--yellow);text-shadow:0 3px 0 #000;min-width:1.2em}
.mod p{color:var(--muted);font-size:.95rem}
.bonus{margin-top:28px;display:grid;gap:16px}
.bonus > h3{color:var(--green)}
.bonus .mod{border-color:var(--green)}
.bonus .mod .n{color:var(--green);font-size:1.5rem;align-self:start}

.fit{display:grid;gap:16px}
@media (min-width:760px){.fit{grid-template-columns:1fr 1fr}}
.fit__box{background:var(--panel);border:2px solid #000;border-radius:16px;padding:22px;display:grid;gap:14px;align-content:start}

/* Oferta */
.offerwrap{position:relative;border-radius:28px;border:3px solid #000;overflow:hidden;box-shadow:0 12px 0 #00000066;
  background:linear-gradient(180deg,#0a0e2acc,#0a0e2af2),var(--art,radial-gradient(600px 400px at 20% 20%,#3b2a8a,#0a0e2a));background-size:cover;background-position:center}
.offer{display:grid;gap:34px;align-items:center;padding:40px 24px}
@media (min-width:860px){.offer{grid-template-columns:.9fr 1.1fr;padding:56px 48px}}
.book{perspective:1200px;display:grid;place-items:center;padding:10px}
.book__cover{position:relative;width:min(260px,70vw);aspect-ratio:3/4;border-radius:6px 14px 14px 6px;background:linear-gradient(160deg,#141c55,#0a0e2a 70%);border:3px solid #000;
  transform:rotateY(-18deg) rotateX(4deg);box-shadow:18px 22px 0 #00000080,inset 10px 0 0 #00000055;padding:22px 20px 18px 30px;display:grid;align-content:space-between;overflow:hidden}
.book__cover::before{content:"";position:absolute;left:0;top:0;bottom:0;width:14px;background:linear-gradient(90deg,#000,#1c2470)}
.book__cover small{font-family:var(--display);letter-spacing:.12em;color:var(--blue);font-size:.75rem}
.book__cover h3{font-size:2.3rem;line-height:.95;color:#fff;text-shadow:0 3px 0 #000}
.book__cover h3 em{font-style:normal;color:var(--yellow)}
.book__cover img{width:58%;justify-self:end;border-radius:10px;border:2px solid #000;margin-top:8px}
.book__cover p{font-size:.78rem;color:var(--muted)}
.card{background:var(--panel);border:3px solid var(--yellow);border-radius:22px;padding:28px;display:grid;gap:18px;box-shadow:0 8px 0 #000}
.price{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.price b{font-family:var(--display);font-weight:400;font-size:4.2rem;line-height:1;color:var(--yellow);text-shadow:0 4px 0 #000}
.price span{color:var(--muted)}

.closing{text-align:center;display:grid;gap:20px;justify-items:center;padding:56px 20px;background:var(--panel);border:3px solid #000;border-radius:24px;box-shadow:0 10px 0 #00000055}
.closing h2{max-width:15em}

footer{margin-top:80px;border-top:2px solid #000;background:#070a20;padding:30px 0 40px}
footer .wrap{display:grid;gap:10px}
footer p{color:var(--muted);font-size:.88rem;max-width:52em}

.buybar{position:fixed;left:0;right:0;bottom:0;z-index:30;background:#070a20f2;border-top:2px solid #000;backdrop-filter:blur(6px)}
.buybar__in{max-width:1080px;margin:0 auto;padding:10px 20px;display:flex;align-items:center;justify-content:space-between;gap:14px}
.buybar b{font-family:var(--display);font-weight:400;font-size:1.7rem;color:var(--yellow);line-height:1}
.buybar small{display:block;color:var(--muted);font-size:.75rem}
@media (min-width:860px){.buybar{display:none}body{padding-bottom:0}}

@media (max-width:440px){
  .hud__tag{display:none}
  body{font-size:16px}
  .btn{font-size:1.15rem;padding:16px 20px}
  .card{padding:22px}
}
</style>
</head>
<body>

<header class="hud">
  <div class="hud__in">
    <span class="hud__tag">@escolhas.app</span>
    <div class="meter" role="progressbar" aria-label="Progresso da página" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="meter">
      <i id="bar"></i><small>GLOW-UP</small><b id="pct">0%</b>
    </div>
    <a class="btn btn--sm" href="/pagamento" data-buy>Comprar</a>
  </div>
</header>

<main>
  <!-- HERO: o quê + para quem + prova real + CTA específico -->
  <section class="hero wrap">
    <div class="hero__copy">
      <span class="badge">Guia prático · série animada com IA</span>
      <h1>Faça uma série animada com IA que o <em>público vota</em>.</h1>
      <p class="lead">O passo a passo da série do Eduardo: roteiro, narração, vídeo feito com IA e votação nos comentários. Foi assim que uma conta nova chegou a 17,5 milhões de views em 8 episódios.</p>
      <div class="proofrow" aria-label="Resultados da série">
        <span><b>17,5 mi</b>views</span>
        <span><b>220 mil</b>seguidores</span>
        <span><b>8</b>episódios</span>
      </div>
      <div class="cta">
        <a class="btn" href="/pagamento" data-buy>Quero o método por R$ 29,90</a>
        <span class="trigger">Pagamento via Pix · acesso imediato no seu e-mail</span>
        <span class="trust"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1a3.5 3.5 0 0 0-3.5 3.5V7H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1h-.5V4.5A3.5 3.5 0 0 0 8 1Zm-2 6V4.5a2 2 0 1 1 4 0V7H6Z"/></svg>Pagamento seguro via Pix</span>
      </div>
      <p class="fine">Números do Instagram em 31/10/2026, 10h31.</p>
    </div>
    <figure class="phone" style="margin:0 auto">
      <video id="clip" src="data:video/mp4;base64," poster="data:image/webp;base64," autoplay muted loop playsinline aria-label="Trecho real do Dia 5: o momento do upgrade, glow-up sobe de 9% para 12%"></video>
      <figcaption class="phone__tag">Trecho real · Dia 5 · upgrade</figcaption>
    </figure>
  </section>

  <!-- DOR -->
  <section class="block wrap">
    <div class="block__head">
      <h2>O viral passa. <em>A série fica.</em></h2>
      <p class="lead">Três motivos para a maioria dos vídeos explodir e o perfil continuar parado.</p>
    </div>
    <div class="pains">
      <div class="pain"><span class="x">01</span><h3>O vídeo viraliza e ninguém segue</h3><p>A pessoa assiste, ri e vai embora. Sem um motivo para voltar amanhã, a view não vira seguidor.</p></div>
      <div class="pain"><span class="x">02</span><h3>Você não sabe animar</h3><p>No método, você escreve as cenas e gera a narração. A IA desenha, anima, sincroniza a legenda e gera o vídeo.</p></div>
      <div class="pain"><span class="x">03</span><h3>O público some depois do pico</h3><p>Sem uma lista sua (WhatsApp ou e-mail), cada episódio depende do algoritmo para ser visto.</p></div>
    </div>
  </section>

  <!-- SOLUÇÃO -->
  <section class="block wrap" id="ciclo">
    <div class="block__head">
      <h2>O fim de um episódio é <em>o começo do próximo</em></h2>
      <p class="lead">O público escolhe, o personagem muda, e quem votou volta para ver o que aconteceu.</p>
    </div>
    <div class="loop">
      <div class="step"><figure><img src="data:image/webp;base64," alt="Abertura do Dia 1: o personagem no quarto bagunçado"></figure><h3><span>1</span>Episódio</h3><p>A história avança em contagem regressiva, com episódios de 92 a 136 segundos.</p></div>
      <div class="step"><figure><img src="data:image/webp;base64," alt="Tela de votação do Dia 1: Dentes ou Quarto"></figure><h3><span>2</span>Votação</h3><p>O vídeo termina com duas opções e um pedido: comente uma palavra.</p></div>
      <div class="step"><figure><img src="data:image/webp;base64," alt="Abertura do Dia 5: vocês escolheram academia"></figure><h3><span>3</span>Resultado</h3><p>O episódio seguinte abre com o que o público escolheu.</p></div>
      <div class="step"><figure><img src="data:image/webp;base64," alt="O personagem no Dia 5, depois de quatro escolhas"></figure><h3><span>4</span>Consequência</h3><p>O personagem muda e o glow-up sobe 3%. Quem votou quer ver o resultado.</p></div>
    </div>
    <p class="loop__back">
      <svg viewBox="0 0 34 34" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M27 12a11 11 0 1 0 2 9"/><path d="M28 4v8h-8"/></svg>
      A consequência vira o gancho do episódio seguinte
    </p>

    <div class="pipe" aria-label="Como cada episódio é produzido">
      <div><h3>Roteiro</h3><p>Cenas numeradas seguindo a narração, com o estado do personagem e do HUD em cada dia.</p></div>
      <div><h3>Narração</h3><p>Texto com marcações de tom de voz, transformado em áudio com IA.</p></div>
      <div><h3>Vídeo com IA</h3><p>1080x1920 a 30 fps, legenda sincronizada palavra por palavra e prévia de 12 quadros antes do render final.</p></div>
      <div><h3>Publicação</h3><p>Pedido de voto na legenda e no vídeo. A palavra mais comentada vira o próximo episódio.</p></div>
    </div>

    <div class="cta inline-cta">
      <a class="btn" href="/pagamento" data-buy>Quero fazer a minha série</a>
      <span class="trigger">R$ 29,90 · Pix · acesso imediato no seu e-mail</span>
    </div>
  </section>

  <!-- PROVA -->
  <section class="block">
    <div class="wrap">
      <div class="block__head">
        <h2>A prova está <em>no perfil</em></h2>
        <p class="lead">Conta nova, público brasileiro, oito episódios. Confira em @escolhas.app no Instagram.</p>
      </div>
      <div class="proof">
        <div class="proof__img"><img src="data:image/webp;base64," alt="Print dos oito episódios no perfil @escolhas.app, com as views de cada um, em 31/10/2026"></div>
        <div>
          <ul class="eps" aria-label="Views por episódio">
            <li><span>Dia 1 · Laura</span><b>3,6 mi</b></li>
            <li><span>Dia 2 · Quarto</span><b>2,6 mi</b></li>
            <li><span>Dia 3 · Banho</span><b>3,1 mi</b></li>
            <li><span>Dia 4 · Dentes</span><b>2,4 mi</b></li>
            <li><span>Dia 5 · Academia</span><b>1,9 mi</b></li>
            <li><span>Dia 6 · Roupas</span><b>2,2 mi</b></li>
            <li><span>Dia 7 · Cabelo</span><b>1,1 mi</b></li>
            <li><span>Dia 8 · Pele</span><b>606 mil</b></li>
          </ul>
          <p class="fine" style="margin-top:10px">Views mostradas pelo Instagram em 31/10/2026, 10h31.</p>
        </div>
      </div>
    </div>
    <div class="strip" tabindex="0" aria-label="Quadros dos episódios">
      <figure><img src="data:image/webp;base64," alt="Abertura do Dia 1"><figcaption>Dia 1 · abertura</figcaption></figure>
      <figure><img src="data:image/webp;base64," alt="Banheiro no Dia 1"><figcaption>Dia 1 · banheiro</figcaption></figure>
      <figure><img src="data:image/webp;base64," alt="Mercado no Dia 1"><figcaption>Dia 1 · mercado</figcaption></figure>
      <figure><img src="data:image/webp;base64," alt="Votação no Dia 1"><figcaption>Dia 1 · votação</figcaption></figure>
      <figure><img src="data:image/webp;base64," alt="Dentista no Dia 4"><figcaption>Dia 4 · dentista</figcaption></figure>
      <figure><img src="data:image/webp;base64," alt="Resultado no Dia 5"><figcaption>Dia 5 · resultado</figcaption></figure>
      <figure><img src="data:image/webp;base64," alt="Academia no Dia 5"><figcaption>Dia 5 · academia</figcaption></figure>
      <figure><img src="data:image/webp;base64," alt="Personagem no Dia 5"><figcaption>Dia 5 · glow-up 9%</figcaption></figure>
    </div>
    <div class="wrap">
